# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AWS / CloudFront
NEXT_PUBLIC_CLOUDFRONT_URL=https://xxxx.cloudfront.net/postcards

# S3 
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
S3_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com/postcards/

# NextAuth secret for authentication
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

#Stripe API keys for payment processing
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Stripe webhook secret for verifying incoming webhook requests
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxx

# AWS SES credentials for sending emails
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_REGION=us-east-1
SES_FROM_EMAIL=you@yourdomain.com

# Upstash Redis credentials for caching and session management
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here

# Google OAuth credentials are stored in AWS Secrets Manager
# Secret name: /postcard-store/production/auth
# Keys: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET