# Database
DATABASE_URL=postgresql://user:password@host:5432/dbname

# AWS / CloudFront
NEXT_PUBLIC_CLOUDFRONT_URL=https://xxxx.cloudfront.net/postcards

# S3 
S3_BUCKET_NAME=your-bucket-name
S3_REGION=us-east-1
S3_BASE_URL=https://your-bucket-name.s3.us-east-1.amazonaws.com/postcards/

# NextAuth secret for authentication
AUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth credentials are stored in AWS Secrets Manager
# Secret name: /postcard-store/production/auth
# Keys: AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET